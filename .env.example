# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/appmarket

# ── JWT ───────────────────────────────────────────────────────────────────────
# Minimum 32 characters. Use a cryptographically random value in production.
JWT_SECRET=change-me-to-a-random-32-char-secret-key
JWT_REFRESH_SECRET=change-me-to-a-different-32-char-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Redis (BullMQ) ────────────────────────────────────────────────────────────
# Optional — workers are disabled when not set
REDIS_URL=redis://localhost:6379

# ── Cloudinary (media storage) ────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
